# ==============================================================================
# ELEGAL ENTERPRISE LEGAL SUITE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# 1. FRONTEND CONFIGURATION (VITE)
VITE_APP_NAME="ELegal Enterprise Suite"
VITE_APP_ENV="development"
VITE_LEGAL_API_URL="http://localhost:8080/api/v1/legal"
VITE_USE_MOCK="false"

# 2. BACKEND SERVER CONFIGURATION (GOLANG / NODE)
SERVER_PORT=8080
SERVER_HOST="0.0.0.0"
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s

# 3. DATABASE CONFIGURATION (POSTGRESQL 14+)
DB_HOST="127.0.0.1"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="your_secure_password"
DB_NAME="eranetic_erp_db"
DB_SCHEMA="legal"
DB_SSL_MODE="disable"
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# 4. OBJECT STORAGE (MINIO / AWS S3 FOR DIGITAL VAULT)
STORAGE_DRIVER="minio"
STORAGE_ENDPOINT="127.0.0.1:9000"
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="minioadmin"
STORAGE_BUCKET_NAME="legal-vault"
STORAGE_USE_SSL="false"
STORAGE_PUBLIC_BASE_URL="http://127.0.0.1:9000/legal-vault"

# 5. ERP SINGLE SIGN-ON (SSO OIDC / JWT INTEGRATION)
ERP_SSO_PROVIDER_URL="https://sso.eranetic.internal"
ERP_SSO_CLIENT_ID="elegal-app-client"
ERP_SSO_CLIENT_SECRET="your_client_secret_from_erp"
ERP_JWT_PUBLIC_KEY_PATH="/etc/secrets/erp_jwt_public.pem"
ERP_SYNC_WEBHOOK_SECRET="whsec_elegal_sync_secret"

# 6. MESSAGE BROKER (RABBITMQ — EVENT DRIVEN AUDIT & NOTIFICATION)
RABBITMQ_URL="amqp://guest:guest@127.0.0.1:5672/"
RABBITMQ_EXCHANGE_NAME="erp.events"
RABBITMQ_QUEUE_NAME="legal.events.queue"

# 7. LOGGING & TELEMETRY
LOG_LEVEL="debug"
LOG_FORMAT="json"
